# Path to the Antigravity CLI binary (agy or agy.exe)
# If not specified, the adapter attempts to find agy in %LOCALAPPDATA%/agy/bin/agy.exe or PATH
ANTIGRAVITY_BIN_PATH="C:\\Users\\DESK0034\\AppData\\Local\\agy\\bin\\agy.exe"

# Semicolon or comma-separated list of absolute paths where execution is permitted
DEVFLOW_ALLOWED_WORKING_DIRS="d:\\D drive\\DevFlow"

# Default execution timeout in milliseconds (default: 60000ms = 1m)
DEVFLOW_TIMEOUT_MS=60000

# Set to "true" to enable the opt-in live Antigravity CLI integration test
DEVFLOW_INTEGRATION_TEST=false

# Linear API Key (personal API key from https://linear.app/settings/api)
# Keep empty or unset in .env.example. NEVER commit real API keys.
LINEAR_API_KEY=""

# Linear GraphQL Endpoint (defaults to https://api.linear.app/graphql)
LINEAR_API_URL="https://api.linear.app/graphql"

# Set to "true" to run opt-in live Linear GraphQL integration tests
LINEAR_INTEGRATION_TEST=false

# Directory where generated ticket implementation plans are saved
DEVFLOW_PLANS_DIR="data/plans"
